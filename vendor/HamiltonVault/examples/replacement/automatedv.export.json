{
  "name": "sales_vault",
  "vars": {
    "hash": "MD5",
    "hash_storage": "binary"
  },
  "sources": {
    "raw_crm": {
      "path": "crm.csv",
      "columns": [
        "CUSTOMER_ID",
        "NAME",
        "CITY",
        "INGESTED_AT"
      ]
    },
    "raw_erp": {
      "path": "erp.csv",
      "columns": [
        "ACCOUNT_ID",
        "ORDER_ID",
        "AMOUNT",
        "STATUS",
        "INGESTED_AT",
        "EFFECTIVE_AT"
      ]
    }
  },
  "stages": {
    "crm": {
      "source_model": "raw_crm",
      "derived_columns": {
        "LOAD_DTS": "INGESTED_AT",
        "RECORD_SOURCE": "!CRM"
      },
      "hashed_columns": {
        "CUSTOMER_HK": {
          "columns": "CUSTOMER_ID"
        },
        "CUSTOMER_HASHDIFF": {
          "columns": [
            "NAME",
            "CITY"
          ],
          "is_hashdiff": true
        }
      }
    },
    "erp": {
      "source_model": "raw_erp",
      "derived_columns": {
        "CUSTOMER_ID": "ACCOUNT_ID",
        "LOAD_DTS": "INGESTED_AT",
        "RECORD_SOURCE": "!ERP"
      },
      "hashed_columns": {
        "CUSTOMER_HK": {
          "columns": "CUSTOMER_ID"
        },
        "ORDER_HK": {
          "columns": "ORDER_ID"
        },
        "CUSTOMER_ORDER_HK": {
          "columns": [
            "CUSTOMER_ID",
            "ORDER_ID"
          ]
        },
        "ORDER_HASHDIFF": {
          "columns": [
            "STATUS",
            "AMOUNT"
          ],
          "is_hashdiff": true
        }
      }
    }
  },
  "models": [
    {
      "macro": "automate_dv.hub",
      "name": "hub_customer",
      "source_model": [
        "crm",
        "erp"
      ],
      "src_pk": "CUSTOMER_HK",
      "src_nk": [
        "CUSTOMER_ID"
      ],
      "src_ldts": "LOAD_DTS",
      "src_source": "RECORD_SOURCE"
    },
    {
      "macro": "automate_dv.hub",
      "name": "hub_order",
      "source_model": "erp",
      "src_pk": "ORDER_HK",
      "src_nk": [
        "ORDER_ID"
      ],
      "src_ldts": "LOAD_DTS",
      "src_source": "RECORD_SOURCE"
    },
    {
      "macro": "automate_dv.link",
      "name": "link_customer_order",
      "source_model": "erp",
      "src_pk": "CUSTOMER_ORDER_HK",
      "src_fk": [
        "CUSTOMER_HK",
        "ORDER_HK"
      ],
      "references": {
        "CUSTOMER_HK": "hub_customer",
        "ORDER_HK": "hub_order"
      },
      "src_ldts": "LOAD_DTS",
      "src_source": "RECORD_SOURCE"
    },
    {
      "macro": "automate_dv.sat",
      "name": "sat_customer",
      "source_model": "crm",
      "src_pk": "CUSTOMER_HK",
      "src_hashdiff": "CUSTOMER_HASHDIFF",
      "src_payload": [
        "NAME",
        "CITY"
      ],
      "parent": "hub_customer",
      "src_ldts": "LOAD_DTS",
      "src_source": "RECORD_SOURCE"
    },
    {
      "macro": "automate_dv.sat",
      "name": "sat_order",
      "source_model": "erp",
      "src_pk": "CUSTOMER_ORDER_HK",
      "src_hashdiff": "ORDER_HASHDIFF",
      "src_payload": [
        "AMOUNT",
        "STATUS"
      ],
      "src_eff": "EFFECTIVE_AT",
      "parent": "link_customer_order",
      "src_ldts": "LOAD_DTS",
      "src_source": "RECORD_SOURCE"
    }
  ]
}
