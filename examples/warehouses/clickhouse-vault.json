{
  "warehouse": {
    "type": "clickhouse",
    "connection": {
      "host": {
        "env": "CLICKHOUSE_HOST"
      },
      "username": {
        "env": "CLICKHOUSE_USER"
      },
      "password": {
        "env": "CLICKHOUSE_PASSWORD"
      },
